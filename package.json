{
  "name": "@ferdiunal/open-play-mcp",
  "version": "0.2.0",
  "description": "MCP server for the Open Play developer documentation and SDK API (TypeScript + Unity)",
  "license": "MIT",
  "author": "Ferdi ÜNAL",
  "repository": "github:ferdiunal/open-play-mcp",
  "homepage": "https://open-play.b4klabs.dev/docs/",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "open-play",
    "documentation"
  ],
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "open-play-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "snapshot/index.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "update-snapshot": "node scripts/update-snapshot.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
